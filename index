<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<title>Veronika's 18th — Movie + Charcuterie Night</title>
<style>
@import url('https://fonts.googleapis.com/css2?family=DM+Serif+Display:ital@0;1&family=Barlow+Condensed:wght@400;500;600;700&display=swap');

:root{
  --wine: #7A1F2B;
  --wine-deep: #4E1119;
  --board: #8A5A34;
  --board-dark: #6E4526;
  --parchment: #F4ECD8;
  --parchment-dim: #E9DBBE;
  --gold: #C99A3E;
  --gold-light: #E3BD6E;
  --ink: #2E241A;
  --olive: #6E7A45;
  --grape: #5B3B6B;
  --cheese: #E8B54A;
  --cheese-dark: #D69A2C;
  --salami: #B5432F;
}

*{ box-sizing: border-box; }

html, body{
  margin:0;
  padding:0;
  width:100%;
  min-height:100vh;
  background: radial-gradient(ellipse at 50% 15%, #7A3320 0%, var(--board-dark) 65%, #3B2313 100%);
  font-family: 'Barlow Condensed', sans-serif;
  color: var(--ink);
  display:flex;
  align-items:center;
  justify-content:center;
  overflow-x:hidden;
}

.stage{
  position:relative;
  width:100%;
  max-width:560px;
  padding: 28px 16px;
  display:flex;
  flex-direction:column;
  align-items:center;
}

/* ---------- Confetti ---------- */
.confetti-layer{
  position:absolute;
  inset:0;
  pointer-events:none;
  overflow:visible;
  z-index:20;
}

.confetti-piece{
  position:absolute;
  top:-30px;
  left:var(--left);
  width: var(--size);
  height: var(--size);
  opacity:0;
  animation: confettiFall var(--dur) var(--delay) cubic-bezier(.32,.1,.55,1) forwards;
}

@keyframes confettiFall{
  0%{ transform: translate(0,0) rotate(0deg); opacity:0; }
  6%{ opacity:1; }
  100%{ transform: translate(var(--dx), var(--fall)) rotate(var(--rot)); opacity:0; }
}

/* ---------- Envelope ---------- */
.envelope-wrap{
  perspective: 1400px;
  width: 100%;
  max-width: 500px;
  cursor:pointer;
  user-select:none;
  -webkit-tap-highlight-color: transparent;
  position:relative;
  z-index:2;
}

.envelope{
  position:relative;
  width:100%;
  aspect-ratio: 360 / 240;
}

.env-body{
  position:absolute;
  inset:0;
  background: linear-gradient(155deg, var(--board) 0%, var(--board-dark) 100%);
  border-radius: 4px;
  box-shadow: 0 20px 45px rgba(0,0,0,.5), inset 0 0 0 1px rgba(227,189,110,.3);
  overflow:hidden;
}

.env-body::before{
  content:"";
  position:absolute;
  inset:0;
  background:
    linear-gradient(115deg, rgba(0,0,0,.28) 0%, transparent 32%),
    linear-gradient(245deg, rgba(0,0,0,.28) 0%, transparent 32%);
}

.card-peek{
  position:absolute;
  left:6%;
  right:6%;
  top:8%;
  bottom:0;
  background: var(--parchment);
  border-radius: 3px 3px 0 0;
  box-shadow: 0 -2px 10px rgba(0,0,0,.2);
  transition: transform .05s;
  z-index:2;
}

.envelope-wrap.open .card-peek{
  animation: cardPop .95s cubic-bezier(.34,1.1,.4,1) .78s forwards;
}

@keyframes cardPop{
  0%{ transform: translateY(0) rotate(0deg); }
  45%{ transform: translateY(-72%) rotate(-3.5deg); }
  70%{ transform: translateY(-92%) rotate(2.5deg); }
  88%{ transform: translateY(-83%) rotate(-1deg); }
  100%{ transform: translateY(-86%) rotate(0deg); }
}

.flap{
  position:absolute;
  top:0; left:0; right:0;
  height: 62%;
  transform-origin: top center;
  transform-style: preserve-3d;
  z-index:4;
  clip-path: polygon(0 0, 100% 0, 50% 100%);
  background: linear-gradient(160deg, #9A6A3F, var(--board) 60%);
}

.flap::after{
  content:"";
  position:absolute;
  inset:0;
  box-shadow: inset 0 -1px 0 rgba(227,189,110,.35);
}

.envelope-wrap.open .flap{
  animation: flapOpen .75s cubic-bezier(.3,0,.25,1) .18s forwards;
}

@keyframes flapOpen{
  0%{ transform: rotateX(0deg); }
  65%{ transform: rotateX(205deg); }
  85%{ transform: rotateX(170deg); }
  100%{ transform: rotateX(180deg); }
}

.seal{
  position:absolute;
  top: 46%;
  left:50%;
  width:58px;
  height:58px;
  transform: translate(-50%,-50%);
  z-index:5;
  animation: sealPulse 2.4s ease-in-out infinite;
}

.envelope-wrap.open .seal{ animation:none; }

@keyframes sealPulse{
  0%, 100%{ transform: translate(-50%,-50%) scale(1); }
  50%{ transform: translate(-50%,-50%) scale(1.06); }
}

.seal-half{
  position:absolute;
  inset:0;
  border-radius:50%;
  background: radial-gradient(circle at 35% 30%, var(--gold-light), var(--gold) 55%, #8A6222 100%);
  box-shadow: 0 4px 10px rgba(0,0,0,.45);
  display:flex;
  align-items:center;
  justify-content:center;
  font-family:'DM Serif Display', serif;
  font-size: 26px;
  font-style: italic;
  color: var(--wine-deep);
  transition: transform .55s cubic-bezier(.5,0,.2,1), opacity .55s ease;
}

.seal-half span{ display:block; }
.seal-half.top{ clip-path: inset(0 0 50% 0); }
.seal-half.bottom{ clip-path: inset(50% 0 0 0); }

.envelope-wrap.open .seal-half.top{
  transform: translateY(-46px) rotate(-30deg);
  opacity:0;
}
.envelope-wrap.open .seal-half.bottom{
  transform: translateY(46px) rotate(28deg);
  opacity:0;
}

.prompt{
  margin-top: 22px;
  text-align:center;
  color: var(--parchment-dim);
  font-size: 19px;
  letter-spacing: .04em;
  transition: opacity .35s ease;
}

.prompt .sub{
  display:block;
  font-size:14px;
  color: rgba(244,236,216,.55);
  margin-top:2px;
}

.envelope-wrap.open .prompt{
  opacity:0;
  pointer-events:none;
}

/* ---------- Card ---------- */
.card{
  width:100%;
  max-width:500px;
  background: var(--parchment);
  border-radius: 3px;
  box-shadow: 0 25px 50px rgba(0,0,0,.4);
  padding: 40px 42px 34px;
  opacity:0;
  transform: translateY(20px) scale(.98);
  transition: opacity .5s ease, transform .5s ease;
  position:relative;
  z-index:1;
  margin-top:-10px;
}

.card.show{
  opacity:1;
  transform: translateY(0) scale(1);
}

.card::before{
  content:"";
  position:absolute;
  inset:10px;
  border: 1px solid rgba(201,154,62,.55);
  pointer-events:none;
}

.board-icon{
  display:block;
  margin: 0 auto 16px;
  width: 128px;
  height: 90px;
}

.headline{
  font-family:'DM Serif Display', serif;
  font-style:italic;
  font-size: 52px;
  line-height: 1.05;
  text-align:center;
  color: var(--wine);
  margin: 0;
}

.headline .num{
  font-style:normal;
  color: var(--gold);
}

.subline{
  text-align:center;
  font-size: 24px;
  letter-spacing:.04em;
  color: var(--olive);
  margin: 8px 0 26px;
  font-weight:500;
}

.subline::before,
.subline::after{
  content:"◆";
  font-size:9px;
  vertical-align:middle;
  color: var(--gold);
  margin: 0 9px;
}

.stub{
  border-top: 2px dashed rgba(122,31,43,.3);
  border-bottom: 2px dashed rgba(122,31,43,.3);
  padding: 16px 0;
  margin-bottom: 18px;
}

.row{
  display:flex;
  justify-content:space-between;
  align-items:baseline;
  padding: 7px 0;
  font-size: 22px;
}

.row .label{
  color: var(--olive);
  font-weight:600;
  letter-spacing:.03em;
}

.row .value{
  color: var(--ink);
  text-align:right;
  font-weight:500;
}

.admit{
  text-align:center;
  font-size: 13px;
  letter-spacing: .32em;
  color: var(--gold-dark, #B5842F);
  font-weight:700;
  margin-top: 6px;
}

.footer-line{
  text-align:center;
  font-size:19px;
  color: var(--ink);
  line-height:1.5;
}

.footer-line b{
  color: var(--wine);
  font-weight:600;
}

@media (max-width:380px){
  .headline{ font-size:32px; }
  .row{ font-size:17px; }
}
</style>
</head>
<body>

<div class="stage" id="stage">

  <div class="confetti-layer" id="confettiLayer"></div>

  <div class="envelope-wrap" id="envWrap">
    <div class="envelope">
      <div class="env-body"></div>
      <div class="card-peek"></div>
      <div class="flap"></div>
      <div class="seal">
        <div class="seal-half top"><span>V</span></div>
        <div class="seal-half bottom"><span>V</span></div>
      </div>
    </div>
    <div class="prompt" id="prompt">tap the seal to open<span class="sub"></span></div>
  </div>

  <div class="card" id="card">
    <svg class="board-icon" viewBox="0 0 130 90" xmlns="http://www.w3.org/2000/svg">
      <ellipse cx="65" cy="72" rx="58" ry="9" fill="#6E4526" opacity=".25"/>
      <rect x="10" y="30" width="110" height="34" rx="14" fill="#9A6A3F"/>
      <rect x="10" y="30" width="110" height="34" rx="14" fill="none" stroke="#6E4526" stroke-width="2"/>
      <path d="M28 28 L48 10 L58 28 Z" fill="#E8B54A" stroke="#B5842F" stroke-width="1.5"/>
      <circle cx="41" cy="21" r="1.6" fill="#B5842F"/>
      <circle cx="47" cy="24" r="1.4" fill="#B5842F"/>
      <ellipse cx="72" cy="22" rx="6" ry="6" fill="#B5432F"/>
      <ellipse cx="80" cy="17" rx="6" ry="6" fill="#B5432F"/>
      <ellipse cx="86" cy="24" rx="6" ry="6" fill="#B5432F"/>
      <circle cx="70" cy="20" r=".8" fill="#F4ECD8"/>
      <circle cx="74" cy="24" r=".8" fill="#F4ECD8"/>
      <circle cx="83" cy="20" r=".8" fill="#F4ECD8"/>
      <g fill="#5B3B6B">
        <circle cx="100" cy="24" r="4.2"/>
        <circle cx="106" cy="20" r="4.2"/>
        <circle cx="106" cy="28" r="4.2"/>
        <circle cx="111" cy="24" r="4.2"/>
      </g>
      <path d="M104 16 q4 -6 8 -2" stroke="#6E7A45" stroke-width="2" fill="none" stroke-linecap="round"/>
    </svg>

    <h1 class="headline">Veronika's <span class="num">18!</span></h1>
    <p class="subline">Movies &amp; Charcuterie</p>

    <div class="stub">
      <div class="row"><span class="label">Where</span><span class="value">Pauli Murray, C-34</span></div>
      <div class="row"><span class="label">When</span><span class="value">Sun, Sept 6</span></div>
      <div class="row"><span class="label">Movies</span><span class="value">7:30 – 10:00 PM</span></div>
      <div class="row"><span class="label">After</span><span class="value">Pre!!</span></div>
      <div class="admit">ADMIT ONE</div>
    </div>

    <p class="footer-line">Text me by Friday to RSVP!<br><b>def feel free to bring +1 :)</b></p>
  </div>

</div>

<script>
  const wrap = document.getElementById('envWrap');
  const card = document.getElementById('card');
  const confettiLayer = document.getElementById('confettiLayer');
  let opened = false;

  // charcuterie-themed confetti icons as inline SVG strings
  const icons = [
    // cheese wedge
    `<svg viewBox="0 0 40 40"><path d="M4 30 L20 8 L36 30 Z" fill="#E8B54A" stroke="#B5842F" stroke-width="2"/><circle cx="17" cy="24" r="1.8" fill="#B5842F"/><circle cx="24" cy="21" r="1.5" fill="#B5842F"/><circle cx="21" cy="27" r="1.3" fill="#B5842F"/></svg>`,
    // grape cluster
    `<svg viewBox="0 0 40 40"><g fill="#5B3B6B"><circle cx="14" cy="16" r="5"/><circle cx="22" cy="14" r="5"/><circle cx="22" cy="24" r="5"/><circle cx="14" cy="26" r="5"/><circle cx="28" cy="19" r="5"/></g><path d="M18 8 q5 -7 10 -3" stroke="#6E7A45" stroke-width="2.4" fill="none" stroke-linecap="round"/></svg>`,
    // salami slice
    `<svg viewBox="0 0 40 40"><circle cx="20" cy="20" r="15" fill="#B5432F" stroke="#7A2418" stroke-width="1.5"/><circle cx="14" cy="15" r="2.2" fill="#F4ECD8"/><circle cx="24" cy="12" r="1.8" fill="#F4ECD8"/><circle cx="27" cy="22" r="2" fill="#F4ECD8"/><circle cx="16" cy="26" r="1.6" fill="#F4ECD8"/><circle cx="22" cy="27" r="1.4" fill="#F4ECD8"/></svg>`,
    // cracker
    `<svg viewBox="0 0 40 40"><rect x="6" y="6" width="28" height="28" rx="4" fill="#D9B26A" stroke="#B5842F" stroke-width="1.5"/><circle cx="14" cy="14" r="1.4" fill="#B5842F"/><circle cx="26" cy="14" r="1.4" fill="#B5842F"/><circle cx="20" cy="20" r="1.4" fill="#B5842F"/><circle cx="14" cy="26" r="1.4" fill="#B5842F"/><circle cx="26" cy="26" r="1.4" fill="#B5842F"/></svg>`,
    // olive
    `<svg viewBox="0 0 40 40"><line x1="20" y1="34" x2="20" y2="10" stroke="#8A6222" stroke-width="2"/><ellipse cx="20" cy="16" rx="7" ry="9" fill="#6E7A45"/><circle cx="20" cy="14" r="2" fill="#B5432F"/></svg>`,
    // film reel (nods to movie night)
    `<svg viewBox="0 0 40 40"><circle cx="20" cy="20" r="16" fill="none" stroke="#7A1F2B" stroke-width="3"/><circle cx="20" cy="20" r="4" fill="#7A1F2B"/><circle cx="20" cy="9" r="3.4" fill="#7A1F2B"/><circle cx="30" cy="15" r="3.4" fill="#7A1F2B"/><circle cx="27" cy="27" r="3.4" fill="#7A1F2B"/><circle cx="13" cy="27" r="3.4" fill="#7A1F2B"/><circle cx="10" cy="15" r="3.4" fill="#7A1F2B"/></svg>`,
    // wine glass
    `<svg viewBox="0 0 40 40"><path d="M12 6 h16 v6 a8 8 0 0 1 -16 0 Z" fill="#7A1F2B" stroke="#4E1119" stroke-width="1.5"/><line x1="20" y1="20" x2="20" y2="30" stroke="#4E1119" stroke-width="2"/><line x1="13" y1="33" x2="27" y2="33" stroke="#4E1119" stroke-width="2" stroke-linecap="round"/><line x1="20" y1="30" x2="20" y2="33" stroke="#4E1119" stroke-width="2"/></svg>`,
    // baguette slice
    `<svg viewBox="0 0 40 40"><ellipse cx="20" cy="20" rx="15" ry="12" fill="#D9B26A" stroke="#9A6A3F" stroke-width="2"/><ellipse cx="20" cy="20" rx="10" ry="7.5" fill="#F4ECD8"/><circle cx="16" cy="18" r="1" fill="#D9B26A"/><circle cx="24" cy="21" r="1" fill="#D9B26A"/><circle cx="20" cy="16" r="0.8" fill="#D9B26A"/></svg>`
  ];

  function burstConfetti(){
    const count = 48;
    for(let i=0;i<count;i++){
      const piece = document.createElement('div');
      piece.className = 'confetti-piece';
      const size = 20 + Math.random()*20;
      const left = Math.random()*100;
      const dx = (Math.random()*220 - 110) + 'px';
      const fall = (460 + Math.random()*260) + 'px';
      const rot = (Math.random()*620 - 310) + 'deg';
      const dur = (2.4 + Math.random()*1.8) + 's';
      const delay = (Math.random()*1.1) + 's';
      piece.style.setProperty('--size', size+'px');
      piece.style.setProperty('--left', left+'%');
      piece.style.setProperty('--dx', dx);
      piece.style.setProperty('--fall', fall);
      piece.style.setProperty('--rot', rot);
      piece.style.setProperty('--dur', dur);
      piece.style.setProperty('--delay', delay);
      piece.innerHTML = icons[Math.floor(Math.random()*icons.length)];
      confettiLayer.appendChild(piece);
      setTimeout(() => piece.remove(), 4600);
    }
  }

  wrap.addEventListener('click', () => {
    if (opened) return;
    opened = true;
    wrap.classList.add('open');
    setTimeout(burstConfetti, 650);
    setTimeout(() => card.classList.add('show'), 1150);
  });
</script>

</body>
</html>
